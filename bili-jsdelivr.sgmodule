#!name=B站精简·修复版v5（jsDelivr）
#!desc=顶部只留直播/推荐/热门，删底部会员购/关注，精简「我的」页，去开屏广告，清推荐流广告卡。v5：从匹配层移除实测恒空的 patch/tab/v2 与未使用的 splash/list，消除每次冷启动 5 次空转脚本执行
#!author=Little Code Sauce
#!homepage=https://github.com/BlueberryOvo/ios-clash-module
#!system=ios
#!category=去广告

#==================================================================
# 与仓库里的 bili.sgmodule 完全等价，仅把 script-path 换成 jsDelivr 镜像，
# 用于 GitHub raw 直连不稳的环境。两个模块不要同时导入。
#
# v5 改动（依据 clash-logs-2026-11-17-0244..log 实测）：
#   1) tab 匹配：show|patch -> 只 show（5 次 patch/tab/v2 全部 unchanged，纯空转）
#   2) splash 匹配：show|list -> 只 show（4 次全是 show，list 0 次）
#   3) 保留 5 条独立入口与各自 max-size；脚本编译后 0.00MiB，合并不省内存
#   4) max-size 是跳过阈值不是预分配，数值不变
#
# 注意：Clash-Client 的 script-path 只收 http(s) 绝对 URL，
#      相对路径 ./bili.js、本地文件、data: URI 一律进「已跳过」。
#==================================================================

[Script]
BiliTab     = type=http-response, pattern=^https?://app\.bilibili\.com/x/resource/show/tab(/v2)?, requires-body=1, max-size=524288, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/BlueberryOvo/ios-clash-module@main/bili.js
BiliSplash  = type=http-response, pattern=^https?://app\.bilibili\.com/x/v2/splash/show, requires-body=1, max-size=131072, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/BlueberryOvo/ios-clash-module@main/bili.js
BiliMine    = type=http-response, pattern=^https?://app\.bilibili\.com/x/v2/account/mine, requires-body=1, max-size=1048576, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/BlueberryOvo/ios-clash-module@main/bili.js
BiliFeed    = type=http-response, pattern=^https?://app\.bilibili\.com/x/v2/feed/index, requires-body=1, max-size=1048576, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/BlueberryOvo/ios-clash-module@main/bili.js
BiliMineReq = type=http-request, pattern=^https?://app\.bilibili\.com/x/v2/account/mine, script-update-interval=86400, script-path=https://cdn.jsdelivr.net/gh/BlueberryOvo/ios-clash-module@main/bili.js

# MITM 主机集是"模块 + 你配置里原有的"取并集，日志里图床/gRPC/支付/护照都被接管，
# 说明配置里本来就有一份 B 站域集合——那份才是 50MB 内存预算的主要消耗者。
[MITM]
hostname = %APPEND% app.bilibili.com

# 可选：客户端支持 reject-dict 时取消注释，用 0 脚本成本干掉三个纯广告接口。
#[URL Rewrite]
#^https?://app\.bilibili\.com/x/resource/top/activity - reject-dict
#^https?://app\.bilibili\.com/x/v2/search/defaultwords - reject-dict
#^https?://app\.bilibili\.com/x/resource/ip - reject-dict
